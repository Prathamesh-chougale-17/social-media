# Copy this file to .env or .env.local and fill in the values.
# Example environment variables required by the seed script and app

# MongoDB connection string (replace with your Atlas/Local connection URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mydb?retryWrites=true&w=majority

# Pexels API Key - create an account at https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# -----------------------------------------------------------------------------
# Email (SMTP) - used for verification, password reset, magic links, etc.
# -----------------------------------------------------------------------------
# SMTP host (e.g. smtp.gmail.com, smtp.sendgrid.net)
EMAIL_HOST=smtp.example.com

# SMTP port (587 for TLS, 465 for SSL)
EMAIL_PORT=587

# SMTP username (login)
EMAIL_USER=

# SMTP password
EMAIL_PASSWORD=

# Optional: "From" display name used in outgoing emails
EMAIL_FROM_NAME="Social Media App"


# -----------------------------------------------------------------------------
# Better Auth Configuration
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=super-secret-auth-key-please-change-in-production
BETTER_AUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Google OAuth Configuration
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret